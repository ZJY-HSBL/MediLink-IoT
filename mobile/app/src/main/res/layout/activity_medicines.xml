<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="用药管理" android:textSize="28sp" android:textStyle="bold" />
        <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="药品名称" android:layout_marginTop="18dp" />
        <EditText android:id="@+id/dosage" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="剂量，如 1 tablet" />
        <EditText android:id="@+id/scheduleTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="时间 HH:mm" android:inputType="time" />
        <EditText android:id="@+id/notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="备注" />
        <Button android:id="@+id/addButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="添加用药" android:layout_marginTop="12dp" />
        <LinearLayout android:id="@+id/medicineList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>
